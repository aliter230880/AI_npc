# --- App ---
APP_NAME=character-platform
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Security ---
JWT_SECRET=change-me-to-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# --- DB ---
# dev: SQLite файл; prod: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./character_platform.db

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель по умолчанию для новых персонажей
LLM_DEFAULT_MODEL=mistralai/mistral-nemo
# Опциональный sitewide referer/title для OpenRouter аналитики
OPENROUTER_HTTP_REFERER=https://character.local
OPENROUTER_APP_TITLE=Character Platform

# --- CORS ---
# через запятую
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
